# Copy to .env (same folder) and fill in. .env is git-ignored; keep it readable by you only: chmod 600 .env
# Salin ke .env (folder yang sama) lalu isi. .env diabaikan git; batasi aksesnya: chmod 600 .env
# Never paste a key into a chat with an agent. Jangan pernah menempel key ke chat dengan agent.

# ElevenLabs: voice-over, generated music and sound effects, transcription.
# The tools read it from the nearest .env above the ad project, so this file covers data/projects/*.
# Empty = use the free options (edge-tts voice, local synth music, whisper transcription).
ELEVENLABS_API_KEY=

# Studio web app (node studio/server.mjs). Both are optional.
# Port; "--port" on the command line wins.
STUDIO_PORT=4173
# Where the database, uploads, projects and finished videos live. Relative paths start at the repository root.
# Keep it inside the repository, or the projects no longer sit under this .env and the key above is not found.
STUDIO_DATA=data
